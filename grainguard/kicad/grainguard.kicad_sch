        (at 30 200 0) (font (size 1.5 1.5)))

  (text "I2C bus: SCD41(0x62) + SHT45(0x44) + 24LC02(0x50) + ST25DV(0x53)"
        (at 40 15 0) (font (size 1.27 1.27)))
  (text "1-Wire bus: 9× DS18B20 (parasitic power, strong pull-up via PC0 MOSFET)"
        (at 200 20 0) (font (size 1.27 1.27)))
  (text "Acoustic chain: AE1 piezo -> OPA2376 charge amp -> OPA2380 BPF (20-80kHz) ×2 -> ADL5511 envelope -> MCU ADC (PB0)"
        (at 40 160 0) (font (size 1.27 1.27)))
