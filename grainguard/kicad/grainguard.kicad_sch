  ; ============ NET CONNECTIONS ============

  ; I2C bus: SDA (PA0) and SCL (PA1) connect to SCD41, SHT45, EEPROM, NFC
  (wire (pts (xy 45 30) (xy 55 30)) (stroke (width 0.254)))
  (wire (pts (xy 45 50) (xy 55 50)) (stroke (width 0.254)))
  (wire (pts (xy 255 80) (xy 265 80)) (stroke (width 0.254)))
  (wire (pts (xy 255 105) (xy 265 105)) (stroke (width 0.254)))
  (net "I2C_SDA" (joined (via (at 55 30)) (via (at 55 50)) (via (at 265 80)) (via (at 265 105))))
  (net "I2C_SCL" (joined (via (at 55 35)) (via (at 55 55)) (via (at 265 82)) (via (at 265 107))))

  ; 1-Wire bus: PA8 connects to all 9 DS18B20 DQ pins
  (wire (pts (xy 205 30) (xy 215 30)) (stroke (width 0.254)))
  (wire (pts (xy 205 45) (xy 215 45)) (stroke (width 0.254)))
  (wire (pts (xy 205 60) (xy 215 60)) (stroke (width 0.254)))
  (wire (pts (xy 205 75) (xy 215 75)) (stroke (width 0.254)))
  (wire (pts (xy 205 90) (xy 215 90)) (stroke (width 0.254)))
  (wire (pts (xy 205 105) (xy 215 105)) (stroke (width 0.254)))
  (wire (pts (xy 205 120) (xy 215 120)) (stroke (width 0.254)))
  (wire (pts (xy 205 135) (xy 215 135)) (stroke (width 0.254)))
  (wire (pts (xy 205 150) (xy 215 150)) (stroke (width 0.254)))
  (net "ONEWIRE_DQ" (joined (via (at 215 30)) (via (at 215 45)) (via (at 215 60))
                          (via (at 215 75)) (via (at 215 90)) (via (at 215 105))
                          (via (at 215 120)) (via (at 215 135)) (via (at 215 150))))

  ; Acoustic signal chain: AE1 -> U14 (charge amp) -> U13A -> U13B -> U15 -> MCU ADC
  (wire (pts (xy 45 172) (xy 55 172)) (stroke (width 0.254)))
  (wire (pts (xy 68 170) (xy 75 170)) (stroke (width 0.254)))
  (wire (pts (xy 88 170) (xy 95 170)) (stroke (width 0.254)))
  (wire (pts (xy 108 170) (xy 115 170)) (stroke (width 0.254)))
  (wire (pts (xy 128 168) (xy 140 168)) (stroke (width 0.254)))
  (net "AE_ENVELOPE" (joined (via (at 140 168))))

  ; SPI bus: SCK (PA5), MISO (PA6), MOSI (PA7), CS_FLASH (PA4)
  (wire (pts (xy 255 56) (xy 265 56)) (stroke (width 0.254)))
  (wire (pts (xy 255 53) (xy 265 53)) (stroke (width 0.254)))
  (wire (pts (xy 255 50) (xy 265 50)) (stroke (width 0.254)))
  (wire (pts (xy 255 47) (xy 265 47)) (stroke (width 0.254)))
  (net "SPI_SCK" (joined (via (at 265 56))))
  (net "SPI_MISO" (joined (via (at 265 53))))
  (net "SPI_MOSI" (joined (via (at 265 50))))
  (net "SPI_CS_FLASH" (joined (via (at 265 47))))

  ; Power: 3.3V and GND nets
  (net "+3V3" (joined (via (at 253 33))))
  (net "GND" (joined (via (at 253 37))))

  ; Battery: 3.6V from BAT1 to LDO input
  (wire (pts (xy 253 132) (xy 245 132)) (stroke (width 0.254)))
  (wire (pts (xy 253 128) (xy 245 128)) (stroke (width 0.254)))
  (net "VBAT" (joined (via (at 245 130))))

  ; ---- Antenna connection ----
  (net "RF_ANT" (joined (via (at 130 105))))

