  ; ============================================================================
  ;  Board outline (Edge.Cuts) — 72 × 44 mm, origin at 0,0
  ; ============================================================================
  (gr_line (start 0 0) (end 72 0) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "e1"))
  (gr_line (start 72 0) (end 72 44) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "e2"))
  (gr_line (start 72 44) (end 0 44) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "e3"))
  (gr_line (start 0 44) (end 0 0) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "e4"))

  ; Cuvette cutout (10×10 mm window for the sample vial, top edge centred)
  (gr_line (start 31 0) (end 41 0) (stroke (width 0.15) (type default)) (layer "Edge.Cuts") (uuid "e5"))
  (gr_line (start 41 0) (end 41 10) (stroke (width 0.15) (type default)) (layer "Edge.Cuts") (uuid "e6"))
  (gr_line (start 41 10) (end 31 10) (stroke (width 0.15) (type default)) (layer "Edge.Cuts") (uuid "e7"))
  (gr_line (start 31 10) (end 31 0) (stroke (width 0.15) (type default)) (layer "Edge.Cuts") (uuid "e8"))

