  ; ============================================================================
  ;  Inkwell top-level schematic
  ;  Author: jayis1 — Copyright (C) 2026 jayis1
  ;  4-layer rigid-flex pen PCB. Rigid section behind the grip carries the
  ;  nRF52833, BMI270, BMM150, W25Q64 flash, MAX17048, MCP73831. A flex tail
  ;  runs forward to the nib head PCB with the HX711 + strain gauge and the
  ;  PMW3360 optical flow.
  ; ============================================================================

  (symbol "logo_jayis1"
    (pin_numbers (sym_num nat))
    (pin_names (offset 1.016) (hide yes))
    (in_bom yes)
    (on_board yes)
    (property "Reference" "LOGO" (at 0 0 0))
    (property "Value" "jayis1" (at 0 -2 0)))

