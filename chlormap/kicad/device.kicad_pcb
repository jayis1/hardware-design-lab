    (pad "1" smd rect (at -0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 7 "VANA"))
    (pad "2" smd rect (at 0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "GND"))
  )

  /* C4: 10uF U2 analog bulk */
  (footprint "Capacitor_SMD:C_0603_1608Metric" (at 63 20 0)
    (layer "F.Cu")
    (property "Reference" "C4") (property "Value" "10uF")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 7 "VANA"))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "GND"))
  )

  /* C5: 100nF U3 BLE */
  (footprint "Capacitor_SMD:C_0402_1005Metric" (at 72 40 0)
    (layer "F.Cu")
    (property "Reference" "C5") (property "Value" "100nF")
    (pad "1" smd rect (at -0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 3 "V3R3"))
    (pad "2" smd rect (at 0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "GND"))
  )

  /* C7: 22uF U6 output */
  (footprint "Capacitor_SMD:C_0805_2012Metric" (at 12 45 0)
    (layer "F.Cu")
    (property "Reference" "C7") (property "Value" "22uF")
    (pad "1" smd rect (at -1 0) (size 1 1.2) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 3 "V3R3"))
    (pad "2" smd rect (at 1 0) (size 1 1.2) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "GND"))
  )

  /* ---- Via stitching (GND plane connections) ---- */
  (via (at 35 30) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2 "GND"))
  (via (at 45 30) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2 "GND"))
  (via (at 55 30) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2 "GND"))
  (via (at 65 30) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2 "GND"))
  (via (at 15 45) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2 "GND"))
  (via (at 25 45) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2 "GND"))

  /* ---- Copper pours (ground plane) ---- */
  (zone (net 2) (net_name "GND") (layer "B.Cu") (tstamp 0)
    (hatch edge 0.5)
    (connect_pads (clearance 0.2))
    (min_thickness 0.15)
    (fill yes (thermal_gap 0.2) (thermal_bridge_width 0.3))
    (polygon (pts (xy 0 0) (xy 85 0) (xy 85 52) (xy 0 52)))
  )

  (zone (net 3) (net_name "V3R3") (layer "In2.Cu") (tstamp 1)
    (hatch edge 0.5)
    (connect_pads (clearance 0.2))
    (min_thickness 0.15)
    (fill yes (thermal_gap 0.2) (thermal_bridge_width 0.3))
    (polygon (pts (xy 2 2) (xy 83 2) (xy 83 50) (xy 2 50)))
  )

  /* ---- Design rules ---- */
  (dimension (type orthogonal) (layer "Dwgs.User")
    (pts (xy 0 0) (xy 85 0)) (height 5)
    (gr_text "85 mm" (at 42.5 -3 0) (stroke (width 0.15))))
  (dimension (type orthogonal) (layer "Dwgs.User")
    (pts (xy 0 0) (xy 0 52)) (height 5)
    (gr_text "52 mm" (at -3 26 90) (stroke (width 0.15))))

  /* ---- Board metadata ---- */
  (property "Author" "jayis1")
  (property "Copyright" "2026 jayis1")
  (property "License" "CERN-OHL-S v2")
)

