    (property "Reference" "LCD1") (property "Value" "LS013B7DH03")
    (property "Manufacturer" "Sharp") (property "MPN" "LS013B7DH03")
    (property "Author" "jayis1")
    (pin "1" (uuid "lcd_p01"))  ; VDD
    (pin "2" (uuid "lcd_p02"))  ; VSS
    (pin "3" (uuid "lcd_p03"))  ; SCLK
    (pin "4" (uuid "lcd_p04"))  ; SI (MOSI)
    (pin "5" (uuid "lcd_p05"))  ; SCS (CS)
    (pin "6" (uuid "lcd_p06"))  ; EXTIN
    (pin "7" (uuid "lcd_p07"))  ; EXTCOMIN
    (pin "8" (uuid "lcd_p08"))  ; DISP
  )

  ; ---- TX1: PZT-5H Transducer (center TX) ----
  (symbol (lib_id "Device:PZT-5H_Transducer") (at 50 50 0) (unit 1)
    (in_bom yes) (on_board yes)
    (property "Reference" "TX1") (property "Value" "PZT-5H-1MHz")
    (property "Manufacturer" "Custom") (property "Author" "jayis1")
    (pin "1" (uuid "tx_p01"))   ; +
    (pin "2" (uuid "tx_p02"))   ; -
  )

  ; ---- RX1-RX3: PZT-5H Receiver Transducers ----
  (symbol (lib_id "Device:PZT-5H_Transducer") (at 50 65 0) (unit 1)
    (in_bom yes) (on_board yes)
    (property "Reference" "RX1") (property "Value" "PZT-5H-1MHz")
    (property "Author" "jayis1")
    (pin "1" (uuid "rx1_p01")) (pin "2" (uuid "rx1_p02"))
  )
  (symbol (lib_id "Device:PZT-5H_Transducer") (at 50 75 0) (unit 1)
    (in_bom yes) (on_board yes)
    (property "Reference" "RX2") (property "Value" "PZT-5H-1MHz")
    (property "Author" "jayis1")
    (pin "1" (uuid "rx2_p01")) (pin "2" (uuid "rx2_p02"))
  )
  (symbol (lib_id "Device:PZT-5H_Transducer") (at 50 85 0) (unit 1)
    (in_bom yes) (on_board yes)
    (property "Reference" "RX3") (property "Value" "PZT-5H-1MHz")
    (property "Author" "jayis1")
    (pin "1" (uuid "rx3_p01")) (pin "2" (uuid "rx3_p02"))
  )

  ; ---- U12: LM48611 Audio Amp (TX driver) ----
  (symbol (lib_id "Amplifier_Audio:LM48611") (at 80 50 0) (unit 1)
    (in_bom yes) (on_board yes)
    (property "Reference" "U12") (property "Value" "LM48611")
    (property "Manufacturer" "TI") (property "Author" "jayis1")
    (pin "1" (uuid "amp_p01"))  ; IN
    (pin "2" (uuid "amp_p02"))  ; BYPASS
    (pin "3" (uuid "amp_p03"))  ; SHDN
    (pin "4" (uuid "amp_p04"))  ; VDD
    (pin "5" (uuid "amp_p05"))  ; VOUT+
    (pin "6" (uuid "amp_p06"))  ; VOUT-
    (pin "7" (uuid "amp_p07"))  ; GND
    (pin "8" (uuid "amp_p08"))  ; MUTE
  )

  ; ---- U13: AD8331 VGA (RX preamp) ----
  (symbol (lib_id "Amplifier:AD8331") (at 80 75 0) (unit 1)
    (in_bom yes) (on_board yes)
    (property "Reference" "U13") (property "Value" "AD8331")
    (property "Manufacturer" "Analog Devices") (property "Author" "jayis1")
    (pin "1" (uuid "vga_p01"))  ; VIN
    (pin "2" (uuid "vga_p02"))  ; GAIN
    (pin "3" (uuid "vga_p03"))  ; VOUT
    (pin "4" (uuid "vga_p04"))  ; VDD
    (pin "5" (uuid "vga_p05"))  ; GND
  )

  ; ---- Passive components: decoupling caps, pull-ups, etc. ----
  (symbol (lib_id "Device:C") (at 160 30 0) (unit 1)
