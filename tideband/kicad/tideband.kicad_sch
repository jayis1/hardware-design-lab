  ; ============ WIRES / NETS ============

  ; ---- Power nets ----
  ; VBAT (3.7V from battery) → TPS63020 input
  (wire (pts (xy 140 145) (xy 145 145)) (uuid "w001"))
  ; TPS63020 output (3.3V) → system VDD
  (wire (pts (xy 155 145) (xy 165 145)) (uuid "w002"))

  ; ---- 3.3V power rail ----
  (net "3V3" (uuid "net_3v3"))
  ; ---- GND ----
  (net "GND" (uuid "net_gnd"))
  ; ---- VBAT ----
  (net "VBAT" (uuid "net_vbat"))

  ; ---- I2C1 bus (Pressure, RTC, Fuel gauge) ----
  (net "I2C1_SCL" (uuid "net_i2c1_scl"))
  (net "I2C1_SDA" (uuid "net_i2c1_sda"))
  ; Pull-ups on I2C1
  (wire (pts (xy 160 50) (xy 160 55)) (uuid "w010"))
  (wire (pts (xy 165 50) (xy 165 55)) (uuid "w011"))

  ; ---- I2C2 bus (Magnetometer) ----
  (net "I2C2_SCL" (uuid "net_i2c2_scl"))
  (net "I2C2_SDA" (uuid "net_i2c2_sda"))

  ; ---- SPI1 (Doppler ADC) ----
  (net "SPI1_SCK" (uuid "net_spi1_sck"))
  (net "SPI1_MISO" (uuid "net_spi1_miso"))
  (net "SPI1_MOSI" (uuid "net_spi1_mosi"))
  (net "ADC_CS" (uuid "net_adc_cs"))
  (net "ADC_BUSY" (uuid "net_adc_busy"))

  ; ---- SPI4 (IMU, NAND, LCD — shared bus with separate CS) ----
  (net "SPI4_SCK" (uuid "net_spi4_sck"))
  (net "SPI4_MISO" (uuid "net_spi4_miso"))
  (net "SPI4_MOSI" (uuid "net_spi4_mosi"))
  (net "IMU_CS" (uuid "net_imu_cs"))
  (net "NAND_CS" (uuid "net_nand_cs"))
  (net "LCD_CS" (uuid "net_lcd_cs"))
  (net "NAND_BUSY" (uuid "net_nand_busy"))
  (net "NAND_WP" (uuid "net_nand_wp"))
  (net "IMU_INT" (uuid "net_imu_int"))

  ; ---- USART1 (BLE module) ----
  (net "BLE_TX" (uuid "net_ble_tx"))
  (net "BLE_RX" (uuid "net_ble_rx"))
  (net "BLE_CTS" (uuid "net_ble_cts"))
  (net "BLE_RTS" (uuid "net_ble_rts"))
  (net "BLE_RESET" (uuid "net_ble_reset"))
  (net "BLE_INT" (uuid "net_ble_int"))

  ; ---- Doppler analog signals ----
  (net "DOPPLER_TX" (uuid "net_doppler_tx"))
  (net "DOPPLER_TX_EN" (uuid "net_doppler_tx_en"))
  (net "RX1_SIGNAL" (uuid "net_rx1_sig"))
  (net "RX2_SIGNAL" (uuid "net_rx2_sig"))
  (net "RX3_SIGNAL" (uuid "net_rx3_sig"))
  (net "I_CH1" (uuid "net_i_ch1"))
  (net "Q_CH1" (uuid "net_q_ch1"))
  (net "I_CH2" (uuid "net_i_ch2"))
  (net "Q_CH2" (uuid "net_q_ch2"))
  (net "I_CH3" (uuid "net_i_ch3"))
  (net "Q_CH3" (uuid "net_q_ch3"))
  (net "LO_REF" (uuid "net_lo_ref"))

  ; ---- Haptic ----
  (net "HAPTIC_PWM" (uuid "net_haptic_pwm"))
  (net "HAPTIC_EN" (uuid "net_haptic_en"))

  ; ---- Display control ----
  (net "LCD_DISP" (uuid "net_lcd_disp"))
  (net "LCD_EXTMODE" (uuid "net_lcd_extmode"))

  ; ---- HSE crystal ----
  (net "HSE_IN" (uuid "net_hse_in"))
  (net "HSE_OUT" (uuid "net_hse_out"))

  ; ---- LED ----
  (net "LED" (uuid "net_led"))

  ; ---- RTC backup battery ----
  (net "VBAT_RTC" (uuid "net_vbat_rtc"))

  ; ============ NET LABELS ============
  ; Each label connects to the corresponding net
  (global_label "3V3" (shape input) (at 165 145 0) (effects (font (size 1.27 1.27))))
  (global_label "GND" (shape input) (at 140 160 0) (effects (font (size 1.27 1.27))))
  (global_label "VBAT" (shape input) (at 140 145 0) (effects (font (size 1.27 1.27))))

  (label "I2C1_SCL" (at 120 100 0) (effects (font (size 1.27 1.27))))
  (label "I2C1_SDA" (at 120 105 0) (effects (font (size 1.27 1.27))))
  (label "I2C2_SCL" (at 120 110 0) (effects (font (size 1.27 1.27))))
  (label "I2C2_SDA" (at 120 115 0) (effects (font (size 1.27 1.27))))
  (label "SPI1_SCK" (at 120 120 0) (effects (font (size 1.27 1.27))))
  (label "SPI1_MISO" (at 120 125 0) (effects (font (size 1.27 1.27))))
  (label "SPI1_MOSI" (at 120 130 0) (effects (font (size 1.27 1.27))))
  (label "SPI4_SCK" (at 120 135 0) (effects (font (size 1.27 1.27))))
  (label "SPI4_MISO" (at 120 140 0) (effects (font (size 1.27 1.27))))
  (label "SPI4_MOSI" (at 120 145 0) (effects (font (size 1.27 1.27))))
  (label "BLE_TX" (at 120 150 0) (effects (font (size 1.27 1.27))))
  (label "BLE_RX" (at 120 155 0) (effects (font (size 1.27 1.27))))
  (label "DOPPLER_TX" (at 60 50 0) (effects (font (size 1.27 1.27))))
  (label "HAPTIC_PWM" (at 120 160 0) (effects (font (size 1.27 1.27))))

  ; ============ JUNCTIONS ============
  (junction (at 160 50) (uuid "j001"))
  (junction (at 165 50) (uuid "j002"))

  ; ============ NO-CONNECTION FLAGS ============
  ; (Mark unused pins with NC flag)

  ; ============ TEXT NOTES ============
  (text "TideBand Schematic — jayis1 © 2026"
    (at 50 20 0) (effects (font (size 2.5 2.5) bold)))
  (text "Power: 2× 18650 → TPS63020 → 3.3V"
    (at 50 165 0) (effects (font (size 1.5 1.5))))
  (text "Doppler: 1MHz TX + 3× RX → AD8333 → AD9629 → SPI1"
    (at 50 200 0) (effects (font (size 1.5 1.5))))
  (text "Sensors: ICM-42688 (SPI4) + MMC5983 (I2C2) + MS5837 (I2C1)"
    (at 50 205 0) (effects (font (size 1.5 1.5))))
  (text "Storage: W25N02G 256MB NAND (SPI4) + PCF8523 RTC (I2C1)"
    (at 50 210 0) (effects (font (size 1.5 1.5))))
  (text "Comms: BMD-340 BLE 5.0 (UART1)"
    (at 50 215 0) (effects (font (size 1.5 1.5))))
  (text "Display: Sharp LS013B7DH03 128×128 (SPI4)"
    (at 50 220 0) (effects (font (size 1.5 1.5))))

