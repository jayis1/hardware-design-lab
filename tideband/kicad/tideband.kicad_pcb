  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (title_block
    (title "TideBand — Wrist-Worn Hydrographic Current Profiler PCB")
    (date "2026-08-10")
    (rev "1.0")
    (company "jayis1")
    (comment 1 "Author: jayis1")
    (comment 2 "Copyright © 2026 jayis1. All rights reserved.")
    (comment 3 "License: GPL-2.0 / CERN-OHL-W v2")
    (comment 4 "62×52mm 6-layer PCB, ENIG, 1.6mm thickness")
  )

  ; ============ LAYERS ============
  (layers
    (0 "F.Cu" signal "Top copper — components and high-speed signals")
    (1 "In1.Cu" signal "Inner 1 — GND plane (solid copper pour)")
    (2 "In2.Cu" signal "Inner 2 — 3V3 power plane")
    (3 "In3.Cu" signal "Inner 3 — GND plane (solid copper pour)")
    (31 "B.Cu" signal "Bottom copper — PZT transducers and analog")
    (32 "B.Adhes" user "Bottom adhesive")
    (33 "F.Adhes" user "Top adhesive")
    (34 "B.Paste" user "Bottom solder paste")
    (35 "F.Paste" user "Top solder paste")
    (36 "B.SilkS" user "Bottom silkscreen")
    (37 "F.SilkS" user "Top silkscreen")
    (38 "B.Mask" user "Bottom solder mask")
    (39 "F.Mask" user "Top solder mask")
    (40 "Dwgs.User" user "Design drawings")
    (41 "Cmts.User" user "User comments")
    (42 "Eco1.User" user "Eco1")
    (43 "Eco2.User" user "Eco2")
    (44 "Edge.Cuts" user "Board outline")
    (45 "Margin" user "Board margin")
    (46 "B.CrtYd" user "Bottom courtyard")
    (47 "F.CrtYd" user "Top courtyard")
    (48 "B.Fab" user "Bottom fabrication")
    (49 "F.Fab" user "Top fabrication")
  )

  ; ============ SETUP ============
  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Paste" (type "Top Solder Paste"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 0.2) (material "FR4"))
      (layer "In1.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 2" (type "prepreg") (thickness 0.2) (material "FR4"))
      (layer "In2.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 3" (type "core") (thickness 0.5) (material "FR4"))
      (layer "In3.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 4" (type "prepreg") (thickness 0.2) (material "FR4"))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
      (layer "B.Paste" (type "Bottom Solder Paste"))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
      (copper_finish "ENIG (Electroless Nickel Immersion Gold)")
      (dielectric_constraints no)
    )
    (pad_to_mask_clearance 0.05)
    (solder_mask_min_width 0.0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions yes)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 4)
      (plotframeref no)
      (viasonmirror no)
      (mode 1)
      (useauxorigin no)
      (hpglpdnumiter 5)
      (hpglpdppen1 0)
      (hpglpdppen2 15)
      (hpglpdppen3 2)
      (hpglpdpencolor 1)
      (hpglpdpenspeed 20)
      (hpglpgap 2)
      (hpglpperlayer 1)
      (gerb precision 6)
      (gerb coordinates absolute)
      (gerb header "")
      (gerb footer "")
      (gerberx2 no)
      (gerberx2_attributes yes)
      (gerberx2_netlist no)
      (gerberx2_comments no)
      (excellon coordinates absolute)
      (excellon decimal 6)
      (excellon coordinatesformat 1)
      (excellon zerosheader no)
      (excellon zerosformat 1)
      (excellon units mm)
      (excellon uppercase no)
      (excellonminimalheader no)
