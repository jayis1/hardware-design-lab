  ; ============================================================================
  ;  FrostSentinel top-level schematic
  ;  Author: jayis1 — Copyright (C) 2026 jayis1
  ;  4-layer PCB, 95×62 mm. Sensor head cabled 30 cm above canopy.
  ;  Main MCU: STM32U575ZIT6. LoRa: SX1262. BLE: CC2642R.
  ;  Sensors: MLX90632 (sky IR), 2× PT100 (psychrometer), capacitive leaf
  ;  wetness + PZT AE, SHT45, BMP390, DS18B20.
  ;  Power: SPV1050 solar MPPT + LiFePO₄ 18650 + TPS62740 buck.
  ; ============================================================================
  (symbol "logo_jayis1"
    (pin_numbers (sym_num nat))
    (pin_names (offset 1.016) (hide yes))
    (in_bom yes)
    (on_board yes)
    (property "Reference" "LOGO" (at 0 0 0))
    (property "Value" "jayis1" (at 0 -2 0)))

