(kicad_pcb
  (version 20240108)
  (generator "kicad")
  (generator_version "8.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal "copper")
    (31 "B.Cu" signal "copper")
    (32 "B.Adhes" user "adhes")
    (33 "F.Adhes" user "adhes")
    (34 "B.Paste" user "solderpaste")
    (35 "F.Paste" user "solderpaste")
    (36 "B.SilkS" user "silkscreen")
    (37 "F.SilkS" user "silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "user")
    (41 "Cmts.User" user "user")
    (42 "Eco1.User" user "user")
    (43 "Eco2.User" user "user")
    (44 "Edge.Cuts" user "outline")
    (45 "B.CrtYd" user "courtyard")
    (46 "F.CrtYd" user "courtyard")
    (47 "B.Fab" user "fab")
    (48 "F.Fab" user "fab")
  )
  (setup
    (stackup
      (layer "F.SilkS" (type "Silk Screen"))
      (layer "F.Paste" (type "Solder Paste"))
      (layer "F.Mask" (type "Solder Mask") (color "green"))
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 1.53) (material "FR4"))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Solder Mask") (color "green"))
      (layer "B.Paste" (type "Solder Paste"))
      (layer "B.SilkS" (type "Silk Screen"))
      (copper_finish "ENIG")
      (dielectric_constraints no)
    )
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions yes)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 4)
      (plotframeref no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (pdf_front_fp_property_popups yes)
      (pdf_back_fp_property_popups yes)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output yes)
      (plotreference yes)
      (plotvalue yes)
      (plotfptext yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfromsilk yes)
      (outputformat 1)
      (mirror no)
      (drillshape 0)
      (scaleselection 1)
      (outputdirectory "gerbers/"))
  )

  ;; ================================================================
  ;; Board outline — wrist pod: 48 × 28 mm rounded rectangle
  ;; Author: jayis1
  ;; ================================================================
  (gr_line (start 0 0) (end 48 0)
    (stroke (width 0.1) (type default))
    (layer "Edge.Cuts"))
  (gr_line (start 48 0) (end 48 28)
    (stroke (width 0.1) (type default))
    (layer "Edge.Cuts"))
  (gr_line (start 48 28) (end 0 28)
    (stroke (width 0.1) (type default))
    (layer "Edge.Cuts"))
  (gr_line (start 0 28) (end 0 0)
    (stroke (width 0.1) (type default))
    (layer "Edge.Cuts"))

  (gr_text "Synthand v1.0"
    (at 24 14 0)
    (effects (font (size 2.0 2.0) (thickness 0.3)))
    (layer "F.SilkS"))
  (gr_text "Author: jayis1"
    (at 24 25 0)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
    (layer "F.SilkS"))
  (gr_text "CERN-OHL-S v2"
    (at 24 23 0)
    (effects (font (size 0.8 0.8) (thickness 0.12)))
    (layer "F.SilkS"))

