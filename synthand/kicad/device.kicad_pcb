  (net 45 "LRA_OUT2")
  (net 46 "LRA_OUT3")
  (net 47 "LRA_OUT4")
  (net 48 "NFC_ANT1")
  (net 49 "NFC_ANT2")
  (net 50 "HFXO_P")
  (net 51 "HFXO_N")
  (net 52 "LFXO_P")
  (net 53 "LFXO_N")

