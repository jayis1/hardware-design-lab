  ;; ============================================================
  ;; Board outline — 120 x 18 mm
  ;; ============================================================
  (gr_line (start 0 0) (end 120 0)
    (stroke (width 0.15) (type solid))
    (layer "Edge.Cuts"))
  (gr_line (start 120 0) (end 120 18)
    (stroke (width 0.15) (type solid))
    (layer "Edge.Cuts"))
  (gr_line (start 120 18) (end 0 18)
    (stroke (width 0.15) (type solid))
    (layer "Edge.Cuts"))
  (gr_line (start 0 18) (end 0 0)
    (stroke (width 0.15) (type solid))
    (layer "Edge.Cuts"))

  ;; ============================================================
  ;; Silkscreen text
  ;; ============================================================
  (gr_text "LithoCore v1.0 — jayis1"
    (at 60 16 0)
    (effects (font (size 1.0 1.0) bold))
    (layer "F.SilkS"))

  (gr_text "CERN-OHL-S v2"
    (at 60 1 0)
    (effects (font (size 0.8 0.8)))
    (layer "F.SilkS"))

  (gr_text "CELL+"
    (at 115 5 0)
    (effects (font (size 0.8 0.8)))
    (layer "F.SilkS"))

  (gr_text "CELL-"
    (at 115 13 0)
    (effects (font (size 0.8 0.8)))
    (layer "F.SilkS"))

  ;; ============================================================
  ;; Copper zones — ground pour on top and bottom
  ;; ============================================================
  (zone (net 2) (net_name "GND") (layer "F.Cu") (tstamp 00000001)
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon
      (pts (xy 0.5 0.5) (xy 119.5 0.5) (xy 119.5 17.5) (xy 0.5 17.5))
    )
  )

  (zone (net 2) (net_name "GND") (layer "B.Cu") (tstamp 00000002)
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon
      (pts (xy 0.5 0.5) (xy 119.5 0.5) (xy 119.5 17.5) (xy 0.5 17.5))
    )
  )

  ;; ============================================================
  ;; Internal layers — VDD plane (In1) and GND plane (In2)
  ;; ============================================================
  (zone (net 1) (net_name "VDD") (layer "In1.Cu") (tstamp 00000003)
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes)
    (polygon
      (pts (xy 1 1) (xy 119 1) (xy 119 17) (xy 1 17))
    )
  )

  (zone (net 2) (net_name "GND") (layer "In2.Cu") (tstamp 00000004)
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes)
    (polygon
      (pts (xy 1 1) (xy 119 1) (xy 119 17) (xy 1 17))
    )
  )

  ;; ============================================================
  ;; Vias for ground stitching between layers
  ;; ============================================================
  (via (at 5 3) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 5 15) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 50 3) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 50 15) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 100 3) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 100 15) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 115 3) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 115 15) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))

  ;; VDD vias
  (via (at 60 12) (size 0.6) (drill 0.3) (layers "F.Cu" "In1.Cu") (net 1))
  (via (at 85 12) (size 0.6) (drill 0.3) (layers "F.Cu" "In1.Cu") (net 1))
  (via (at 40 12) (size 0.6) (drill 0.3) (layers "F.Cu" "In1.Cu") (net 1))

