(kicad_pcb
  (version 20231120)
  (generator "pcbnew")
  (generator_version "8.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal "Top")
    (1 "In1.Cu" signal "GND")
    (2 "In2.Cu" signal "PWR")
    (31 "B.Cu" signal "Bottom")
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (stackup
      (layer "F.Cu" (type copper) (thickness 0.035))
      (layer "dielectric 1" (type core) (thickness 0.210) (material "FR4"))
      (layer "In1.Cu" (type copper) (thickness 0.035))
      (layer "dielectric 2" (type core) (thickness 1.065) (material "FR4"))
      (layer "In2.Cu" (type copper) (thickness 0.035))
      (layer "dielectric 3" (type prepreg) (thickness 0.210) (material "FR4"))
      (layer "B.Cu" (type copper) (thickness 0.035))
      (layer "F.Paste" (type soldermask) (thickness 0.01))
      (layer "F.Mask" (type soldermask) (thickness 0.01))
      (layer "B.Paste" (type soldermask) (thickness 0.01))
      (layer "B.Mask" (type soldermask) (thickness 0.01))
      (layer "F.SilkS" (type silkscreen) (thickness 0.015))
      (layer "B.SilkS" (type silkscreen) (thickness 0.015))
      (copper_finish "ENIG")
      (dielectric_constraints no)
    )
    (pad_to_mask_clearance 0.05)
    (solder_mask_min_width 0.04)
    (grid_origin 0 0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacroscale false)
      (usegerberextensions true)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 6)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpenoverlay 0.002500)
      (hpglpenoverlay 0.002500)
      (psnegative false)
      (psa4output true)
      (plotreference true)
      (plotvalue true)
      (plotinvisibletext false)
      (sketchpadsonfab false)
      (subtractmaskfromsilk true)
      (outputformat 1)
      (mirror false)
      (drillshape 0)
      (scaleselection 1)
      (outputdirectory "gerbers/")
    )
    (design_rules
      (min_clearance 0.15)
      (min_track_width 0.15)
      (min_via_diameter 0.4)
      (min_via_drill 0.2)
      (min_microvia_diameter 0.3)
      (min_microvia_drill 0.1)
    )
  )

  ; ====================================================================
  ; Net definitions
  ; ====================================================================
  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "+5V")
  (net 4 "VBAT")
  (net 5 "I2C_SCL")
  (net 6 "I2C_SDA")
  (net 7 "SPI_MOSI")
  (net 8 "SPI_MISO")
  (net 9 "SPI_SCLK")
  (net 10 "RTD_CS")
  (net 11 "CO2_TX")
  (net 12 "CO2_RX")
  (net 13 "I2S_WS")
  (net 14 "I2S_SCK")
  (net 15 "I2S_SD")
  (net 16 "PH_ADC")
  (net 17 "CHG_STAT")
  (net 18 "VBUS_DET")
  (net 19 "E_I+")
  (net 20 "E_I-")
  (net 21 "E_V+")
  (net 22 "E_V-")
  (net 23 "AD5933_VOUT")
  (net 24 "AD5933_VIN")
  (net 25 "AD5933_RFB")
  (net 26 "USB_D+")
  (net 27 "USB_D-")
  (net 28 "RTDIN+")
  (net 29 "RTDIN-")
  (net 30 "REFIN+")
  (net 31 "REFIN-")

  ; ====================================================================
  ; Board outline: 42mm × 85mm (probe form factor)
  ; ====================================================================
  (gr_line (start 0 0) (end 0 85) (stroke (width 0.15) (type solid))
    (layer "Edge.Cuts"))
  (gr_line (start 0 85) (end 42 85) (stroke (width 0.15) (type solid))
    (layer "Edge.Cuts"))
  (gr_line (start 42 85) (end 42 0) (stroke (width 0.15) (type solid))
    (layer "Edge.Cuts"))
  (gr_line (start 42 0) (end 0 0) (stroke (width 0.15) (type solid))
    (layer "Edge.Cuts"))

  ; Silkscreen title
  (gr_text "FermenTiq v1.0 — jayis1 2026" (at 21 82) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.15))))
  (gr_text "FERMENTIQ" (at 21 4) (layer "F.SilkS")
    (effects (font (size 2.5 2.5) (thickness 0.2) bold)))

