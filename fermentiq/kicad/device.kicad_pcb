    (pad "5" smd rect (at 2.25 -1.65) (size 0.9 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 13 "I2S_WS"))
  )

  ; --- U10: AMS1117-3.3 LDO ---
  (footprint "Package_TO_SOT_SMD:SOT-223-3_TabPin2" (layer "F.Cu")
    (tedit 0) (tstamp 00000011)
    (at 32 15)
    (property "Reference" "U10" (at 0 -3))
    (property "Value" "AMS1117-3.3" (at 0 -1.5))
    (property "Manufacturer" "AMS")
    (property "MPN" "AMS1117-3.3")
    (pad "1" smd rect (at -2.3 -1.85) (size 1.2 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "2" smd rect (at 0 1.85) (size 3.6 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "+3V3"))
    (pad "3" smd rect (at 2.3 -1.85) (size 1.2 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "+5V"))
  )

  ; --- J1: USB-C Connector ---
  (footprint "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12" (layer "F.Cu")
    (tedit 0) (tstamp 00000012)
    (at 21 8)
    (property "Reference" "J1" (at 0 -6))
    (property "Value" "USB-C_16P" (at 0 -4.5))
    (property "Manufacturer" "HRO")
    (property "MPN" "TYPE-C-31-M-12")
    (pad "A4" smd rect (at -4 0) (size 0.3 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "+5V"))
    (pad "B9" smd rect (at 4 0) (size 0.3 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "+5V"))
    (pad "A1" smd rect (at -5.5 0) (size 0.3 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "B12" smd rect (at 5.5 0) (size 0.3 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "A6" smd rect (at -2 0) (size 0.3 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 26 "USB_D+"))
    (pad "A7" smd rect (at 0 0) (size 0.3 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 27 "USB_D-"))
  )

  ; --- Passive components ---
  ; R5: 430R reference resistor for MAX31865
  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu")
    (at 5 58)
    (property "Reference" "R5") (property "Value" "430R 0.1%")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 30 "REFIN+"))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 31 "REFIN-")))

  ; R1: 10k I2C pull-up SCL
  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu")
    (at 25 35)
    (property "Reference" "R1") (property "Value" "10k")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "+3V3"))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "I2C_SCL")))

  ; R2: 10k I2C pull-up SDA
  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu")
    (at 27 35)
    (property "Reference" "R2") (property "Value" "10k")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "+3V3"))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 6 "I2C_SDA")))

  ; R6: 1.2k TP4056 charge current set (1A)
  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu")
    (at 15 30)
    (property "Reference" "R6") (property "Value" "1.2k")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")))

  ; C1: 10uF input cap for LDO
  (footprint "Capacitor_SMD:C_0805_2012Metric" (layer "F.Cu")
    (at 35 18)
    (property "Reference" "C1") (property "Value" "10uF")
    (pad "1" smd rect (at -0.875 0) (size 0.95 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "+5V"))
    (pad "2" smd rect (at 0.875 0) (size 0.95 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")))

  ; C2: 100nF decoupling MCU
  (footprint "Capacitor_SMD:C_0603_1608Metric" (layer "F.Cu")
    (at 15 35)
    (property "Reference" "C2") (property "Value" "100nF")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "+3V3"))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")))

  ; C3: 10uF output cap for LDO
  (footprint "Capacitor_SMD:C_0805_2012Metric" (layer "F.Cu")
    (at 29 18)
    (property "Reference" "C3") (property "Value" "10uF")
    (pad "1" smd rect (at -0.875 0) (size 0.95 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "+3V3"))
    (pad "2" smd rect (at 0.875 0) (size 0.95 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")))

  ; C4: 100nF decoupling AD5933
  (footprint "Capacitor_SMD:C_0603_1608Metric" (layer "F.Cu")
    (at 6 65)
    (property "Reference" "C4") (property "Value" "100nF")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "+3V3"))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")))

  ; C5: 1uF VBAT bypass
  (footprint "Capacitor_SMD:C_0603_1608Metric" (layer "F.Cu")
    (at 28 28)
    (property "Reference" "C5") (property "Value" "1uF")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "VBAT"))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")))

  ; --- Probe electrode pads (4 platinum pads on probe face) ---
  (footprint "fermentiq:Probe_Electrode_Pad_6x0.5mm" (layer "F.Cu")
    (at 8 80)
    (property "Reference" "E1") (property "Value" "I+")
    (pad "1" smd rect (at 0 0) (size 6 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 19 "E_I+")))
  (footprint "fermentiq:Probe_Electrode_Pad_6x0.5mm" (layer "F.Cu")
    (at 15 80)
    (property "Reference" "E2") (property "Value" "V+")
    (pad "1" smd rect (at 0 0) (size 6 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 21 "E_V+")))
  (footprint "fermentiq:Probe_Electrode_Pad_6x0.5mm" (layer "F.Cu")
    (at 27 80)
    (property "Reference" "E3") (property "Value" "V-")
    (pad "1" smd rect (at 0 0) (size 6 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 22 "E_V-")))
  (footprint "fermentiq:Probe_Electrode_Pad_6x0.5mm" (layer "F.Cu")
    (at 34 80)
    (property "Reference" "E4") (property "Value" "I-")
    (pad "1" smd rect (at 0 0) (size 6 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 20 "E_I-")))

  ; --- PT100 RTD probe pads (3-wire) ---
  (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" (layer "F.Cu")
    (at 5 50)
    (property "Reference" "RTD1") (property "Value" "PT100_3W")
    (pad "1" thru_hole rect (at 0 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 28 "RTDIN+"))
    (pad "2" thru_hole circle (at 0 2.54) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 29 "RTDIN-"))
    (pad "3" thru_hole circle (at 0 5.08) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 29 "RTDIN-")))

  ; ====================================================================
  ; Vias and GND pours
  ; ====================================================================
  ; GND via stitching (representative)
  (via (at 2 2) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 40 2) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 2 83) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 40 83) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 21 42) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 21 55) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 21 65) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1 "GND"))

  ; Zone fills
  (zone (net 1) (net_name "GND") (layer "In1.Cu") (tstamp 0)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts (xy 0 0) (xy 42 0) (xy 42 85) (xy 0 85))))

  (zone (net 2) (net_name "+3V3") (layer "In2.Cu") (tstamp 1)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts (xy 2 2) (xy 40 2) (xy 40 70) (xy 2 70))))

  (zone (net 1) (net_name "GND") (layer "B.Cu") (tstamp 2)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts (xy 0 0) (xy 42 0) (xy 42 85) (xy 0 85))))
)